includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    level: 6
    stubFiles:
        - phpstan-stubs/spatie-browsershot.php
    paths:
        - app/
        - database/
        - tests/
    tmpDir: storage/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#Trait .+ is used zero times and is not analysed#'
            paths:
                - app/Models/Traits/HasStoreScoping.php
                - app/Livewire/Concerns/HandlesVerbsStateErrors.php
                - tests/Concerns/UsesPostgres.php
        -
            identifier: argument.templateType
            message: '#Unable to resolve the template type TComponent in call to method Livewire\\LivewireManager::test\(\)#'
            path: tests/
        -
            identifier: argument.templateType
            message: '#Unable to resolve the template type T(Key|Value) in call to function collect#'
            path: tests/
        -
            identifier: argument.templateType
            message: '#Unable to resolve the template type TModel in call to method .+::applyIncludes\(\)#'
            path: app/Http/Traits/ResourceActions.php
    scanDirectories:
        - tests/
    universalObjectCratesClasses:
        - Signals\PHPStan\PestTestCase

services:
    -
        class: Signals\PHPStan\PestTestClosureThisExtension
        tags:
            - phpstan.functionParameterClosureThisExtension
